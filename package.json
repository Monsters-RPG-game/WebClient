{
  "name": "monsters-client",
  "version": "0.1.0",
  "description": "MonstersClient",
  "productName": "MonstersClient",
  "author": "https://github.com/Virus288",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start:dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "tsc -w -p tsconfig.json",
    "lint": "cross-env NODE_ENV=development eslint -c eslint.config.mjs . --fix",
    "listErrors": "node_modules/.bin/tsc --skipLibCheck",
    "lintStaged": "npx lint-staged"
  },
  "lint-staged": {
    "*.ts": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "framer-motion": "^12.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.4.1",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-check-file": "^3.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsdoc": "^50.6.8",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
